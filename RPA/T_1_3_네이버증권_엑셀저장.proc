        this.Excel_header = []
        this.Excel_header[0] = []
        this.Excel_header[1] = []

        this.Excel_header[0][0] = Global.Stock[Global.l]
        this.Excel_header[1][0] = '제목'
        this.Excel_header[1][1] = '증권사'
        this.Excel_header[1][2] = '날짜'
        this.Excel_header[1][3] = '내용'


        //------------------------------------------------
