        <Property type="Flow" key="Key_Script" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="let index = 0;&#xD;&#xA;this.email = []&#xD;&#xA;this.user = []&#xD;&#xA;for(let i = 0; i &lt; this.ouput.length; i++) {&#xD;&#xA;    if(this.ouput[i][8] == 'True') {&#xD;&#xA;        this.email[index] = this.ouput[i][1]&#xD;&#xA;        this.user[index++] = this.ouput[i][2]&#xD;&#xA;    }&#xD;&#xA;}" />
