  <JScript><![CDATA[function T_2_2_이메일전송() {

    this.user;
    this.email;
    this.ouput;
    this.DataSource;
    this.connection;

    this.RPAGOTOENABLE = false;
    this.GotoStepRetryCntMap = {};
    this.GotoBlockMap = {4:[6]};
    this.GotoReverseBlockMap = {6:4};
    this.GotoStepBlockTypeMap = {4:'Loop',6:'EndLoop'};


    this.run = function() {

        //------------------------------------------------
        STEP('Sac38be6a2e274e27a3984081465010b4', '[1] DBConnection');
        this.connection = StepPlayer.Run('Desktop.DBConnection', this.dbconnection_info_1); this.DataSource = 'TABLE?users'

        //------------------------------------------------
        STEP('S34e145ac816f4e2c818598d3eb6a9776', '[2] GetDBData');
        this.ouput = StepPlayer.Run('Desktop.GetDBData', this.getdbdata_info_2);

        //------------------------------------------------
        STEP('Sc47b3439dc684f2f83979d07bcfb01e1', '[3] ExecuteScript');
        let index = 0;
        this.email = []
        this.user = []
        for(let i = 0; i < this.ouput.length; i++) {
            if(this.ouput[i][8] == 'True') {
                this.email[index] = this.ouput[i][1]
                this.user[index++] = this.ouput[i][2]
            }
        }

        //------------------------------------------------
        STEP('S830c6f03379b468c9e2aca0349ce3349', '[4] For');
        for (this.i = 0; this.i < this.email.length; this.i++) {

            //------------------------------------------------
            STEP('S4914432faf444640a0100ac4931f1ba4', '[5] SendMail');
            StepPlayer.Run('Net.SendMail', this.sendmail_info_5);

        //------------------------------------------------
        }
        STEP('S554f8babbc85485f89f3f09f6ad78f77', '[6] End-For');


    }

    this.execute = function() {
        var result = null;
        result = this.run()
        if (result != null)
            return result;
    }
}
]]></JScript>
