        <Property type="Flow" key="Key_Script" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="this.Data_use = ToJson(this.Data_use)&#xD;&#xA;&#xD;&#xA;if(this.Data_use[0][1] === '검색 결과가 없습니다.') {&#xD;&#xA;    this.Data_use = 'false'&#xD;&#xA;}else if(this.Data_use.length &gt;= 10) {&#xD;&#xA;    //리포트 10개 추출&#xD;&#xA;    this.Data_num = 16&#xD;&#xA;    this.Data_use = 'true'&#xD;&#xA;}else if(this.Data_use.length &gt; 5 ) {&#xD;&#xA;    //리포트 5개 이상인 경우 경우&#xD;&#xA;    this.Data_num = this.Data_use.length + 5&#xD;&#xA;    this.Data_use = 'true'&#xD;&#xA;}else {&#xD;&#xA;    this.Data_num = this.Data_use.length + 2&#xD;&#xA;    this.Data_use = 'true'&#xD;&#xA;}" />
