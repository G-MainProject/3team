      <RelatedSteps />
      <Script><![CDATA[this.Data_use = ToJson(this.Data_use)

if(this.Data_use[0][1] === '검색 결과가 없습니다.') {
    this.Data_use = 'false'
}else if(this.Data_use.length >= 10) {
    //리포트 10개 추출
    this.Data_num = 16
    this.Data_use = 'true'
}else if(this.Data_use.length > 5 ) {
    //리포트 5개 이상인 경우 경우
    this.Data_num = this.Data_use.length + 5
    this.Data_use = 'true'
}else {
    this.Data_num = this.Data_use.length + 2
    this.Data_use = 'true'
}]]></Script>
