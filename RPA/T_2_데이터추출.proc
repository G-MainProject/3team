  <JScript><![CDATA[function T_2_데이터추출() {

    this.i;
    this.j;
    this.index = 0;
    this.Data_content = [];
    this.Data_header = [];
    this.Data_num;
    this.Data_use;

    this.RPAGOTOENABLE = false;
    this.GotoStepRetryCntMap = {};
    this.GotoBlockMap = {4:[19,27],5:[17],6:[16],7:[9],21:[24,26]};
    this.GotoReverseBlockMap = {19:4,27:4,17:5,16:6,9:7,24:21,26:21};
    this.GotoStepBlockTypeMap = {4:'Decision',19:'Else',27:'EndDecision',5:'Loop',17:'EndLoop',6:'Loop',16:'EndLoop',7:'DecisionThen',9:'EndDecisionThen',21:'Decision',24:'Else',26:'EndDecision'};


    this.run = function() {

        //------------------------------------------------
        STEP('Sb6ecc6f61ced4283bc5deb4e3a0dab17', '[1] Delay');
        Delay(1000);

        //------------------------------------------------
        STEP('S51a6625a5abf4395b271d19cbd967934', '[2] ChromeGetTableData');
        this.Data_use = StepPlayer.Run('Chrome.ChromeGetTableData', this.chromegettabledata_info_2);

        //------------------------------------------------
        STEP('Sc4ad403ae6b8485fb1794375dea84416', '[3] ExecuteScript');
        this.Data_use = ToJson(this.Data_use)

        if(this.Data_use[0][1] === '검색 결과가 없습니다.') {
            this.Data_use = 'false'
        }else if(this.Data_use.length >= 10) {
            //리포트 10개 추출
            this.Data_num = 16
            this.Data_use = 'true'
        }else if(this.Data_use.length > 5 ) {
            //리포트 5개 이상인 경우 경우
            this.Data_num = this.Data_use.length + 5
            this.Data_use = 'true'
        }else {
            this.Data_num = this.Data_use.length + 2
            this.Data_use = 'true'
        }

        //------------------------------------------------
        STEP('Saa0b37cf6b67463c9812508746e49363', '[4] IfElse');
        if (this.Data_use == 'true') {

            //------------------------------------------------
            STEP('S7d2f58f11a224782a59b6287da2caf62', '[5] For');
            for (this.i = 3; this.i < this.Data_num; this.i += 8) {

                //------------------------------------------------
                STEP('S9803a4fa8c7643018e7ce732570753c7', '[6] For');
                for (this.j =  this.i; this.j < this.i + 5; this.j++) {

                    //------------------------------------------------
                    STEP('S632740ca182e49f5b3bdeafce95bd512', '[7] IfThen');
                    if (this.j>= this.Data_num) {

                        //------------------------------------------------
                        STEP('S00f1d748a545476ca180be6e3480bc1d', '[8] Break');
                        break;

                    //------------------------------------------------
                    }
                    STEP('Sb968547279d14c66af6e8a9ba8f7fb2e', '[9] End-IfThen');

                    //------------------------------------------------
                    STEP('S7990c0a8cccc4f0ba067eefe8cc794b9', '[10] ChromeClick');
                    StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_10);

                    //------------------------------------------------
                    STEP('S13e9074c4fc14ebebaa56a2d804ca9bf', '[11] ChromeGetListData');
                    RESULT = StepPlayer.Run('Chrome.ChromeGetListData', this.chromegetlistdata_info_11);

                    //------------------------------------------------
                    STEP('S5ae4f295bc934211953a4cf53e9263c3', '[12] ExecuteScript');
                    this.Data_header[this.index] = [];
                    for(var k = 0; k < RESULT.length; k++) {
                        this.Data_header[this.index][k] = RESULT[k]
                    }

                    //------------------------------------------------
                    STEP('S669eab79b52c470b87f9f666fc07768f', '[13] ChromeGetListData');
                    RESULT = StepPlayer.Run('Chrome.ChromeGetListData', this.chromegetlistdata_info_13);

                    //------------------------------------------------
                    STEP('S83aecd4672334d0b888b936095662a22', '[14] ExecuteScript');
                    RESULT = ToJson(RESULT)

                    this.Data_content[this.index] = [];
                    this.Data_content[this.index].push(RESULT[1]);
                    this.index++;

                    //------------------------------------------------
                    STEP('S12b5b144c97b4d1ea07a702e8050eddd', '[15] KeyInput');
                    StepPlayer.Run('Win.KeyInput', this.keyinput_info_15);

                //------------------------------------------------
                }
                STEP('S4dbb92b1057b4599a675a955a762c877', '[16] End-For');

            //------------------------------------------------
            }
            STEP('S733a90ae015b46a4a6f0229dbbf34ac9', '[17] End-For');

            //------------------------------------------------
            STEP('S7aa4d68872a5473ea5abe50a8d401319', '[18] ExecuteScript');
            for(let i = 0; i < this.Data_header.length; i++) {
              let parts = this.Data_header[i][0].split('\n\n');  
              let body = parts[0].trim();

              // 증권사, 날짜, 조회수
              let metaParts = [];
              let temp = parts[1].split('|');
              
              for (let j = 0; j < temp.length; j++) { 
                  metaParts.push(temp[j].trim()); 
              }

              Global.Data[i] = [body, ...metaParts];
            }

            for(let i = 0; i < this.Data_content.length; i++) {
                let content = this.Data_content[i][0].replace(/\r\n/g, '\n')
                Global.Data[i].push(content)
            }

        //------------------------------------------------
        }else{
            STEP('S7890657ba6744a209cd9197ae216917d', '[19] Else');

            //------------------------------------------------
            STEP('S51a44b92f20442baaa5148578829a261', '[20] InputBox');
            RESULT = InputBox('Yes','Yes/No', '검색결과가 없습니다 다른 조건으로 다시 검색하시겠습니까', 0);

            //------------------------------------------------
            STEP('S0e0ab39d8da346bbb34b5d5c31322873', '[21] IfElse');
            if (RESULT == 'Yes') {

                //------------------------------------------------
                STEP('Sad09db30ff61430aac3dfa0feeae3466', '[22] ChromeClose');
                StepPlayer.Run('Chrome.ChromeClose', this.chromeclose_info_22);

                //------------------------------------------------
                STEP('Sc81196cc053a4ff0a2c8e137952eb5db', '[23] RunTask');
                RunTask(this, 'P_G_MainProject', null);

            //------------------------------------------------
            }else{
                STEP('S2778e3c8e9cc4c23891f85286fe49419', '[24] Else');

                //------------------------------------------------
                STEP('S446ea370ddca4dd3b64676682c3ffb1a', '[25] TerminateAll');
                Exit('Fail', null, null);

            //------------------------------------------------
            }
            STEP('Sd77a990245144c24ba638fff7e6597c9', '[26] End-IfElse');

        //------------------------------------------------
        }
        STEP('S1deea2e5bae841209bf0bb18e9148e03', '[27] End-IfElse');

        //------------------------------------------------
        STEP('S8964dcfa8261442ba654ae01417d6a9d', '[28] ChromeClose');
        StepPlayer.Run('Chrome.ChromeClose', this.chromeclose_info_28);


    }

    this.execute = function() {
        var result = null;
        result = this.run()
        if (result != null)
            return result;
    }
}
]]></JScript>
