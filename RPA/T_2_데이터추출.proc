    <Step id="S7aa4d68872a5473ea5abe50a8d401319" ver="311241220" createVer="311241220" type="Flow" name="ExecuteScript" dpName="ExecuteScript" dpValue="" dpValue2="" dpImage="" tag="" depth="2" stmttype="Normal" enabled="True" mainSet="0">
      <Properties id="730d41c6-463f-40db-83a4-520348500caf" type="Flow">
        <Property type="Flow" key="Options_OnError" controlType="PropertyItemEventHandlerView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="" />
        <Property type="Flow" key="Key_Description" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="" />
        <Property type="Flow" key="Conditions_Title" controlType="String" valueType="System.String" formatType="String" required="True" visible="True" readonly="False" encrypted="False" isChanged="N" value="데이터정제" />
        <Property type="Flow" key="Key_Script" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="for(let i = 0; i &lt; this.Data_header.length; i++) {&#xD;&#xA;  let parts = this.Data_header[i][0].split('\n\n');  &#xD;&#xA;  let body = parts[0].trim();&#xD;&#xA;&#xD;&#xA;  // 증권사, 날짜, 조회수&#xD;&#xA;  let metaParts = [];&#xD;&#xA;  let temp = parts[1].split('|');&#xD;&#xA;  &#xD;&#xA;  for (let j = 0; j &lt; temp.length; j++) { &#xD;&#xA;      metaParts.push(temp[j].trim()); &#xD;&#xA;  }&#xD;&#xA;&#xD;&#xA;  Global.Data[i] = [body, ...metaParts];&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;for(let i = 0; i &lt; this.Data_content.length; i++) {&#xD;&#xA;    let content = this.Data_content[i][0].replace(/\r\n/g, '\n')&#xD;&#xA;    Global.Data[i].push(content)&#xD;&#xA;}" />
      </Properties>
      <RelatedSteps />
      <Script><![CDATA[for(let i = 0; i < this.Data_header.length; i++) {
  let parts = this.Data_header[i][0].split('\n\n');  
  let body = parts[0].trim();

  // 증권사, 날짜, 조회수
  let metaParts = [];
  let temp = parts[1].split('|');
  
  for (let j = 0; j < temp.length; j++) { 
      metaParts.push(temp[j].trim()); 
  }

  Global.Data[i] = [body, ...metaParts];
}

for(let i = 0; i < this.Data_content.length; i++) {
    let content = this.Data_content[i][0].replace(/\r\n/g, '\n')
    Global.Data[i].push(content)
}]]></Script>
    </Step>
