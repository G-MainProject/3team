  <JScript><![CDATA[function T_0_조건설정() {

    this.RPAGOTOENABLE = false;
    this.GotoStepRetryCntMap = {};
    this.GotoBlockMap = {2:[4]};
    this.GotoReverseBlockMap = {4:2};
    this.GotoStepBlockTypeMap = {2:'DecisionThen',4:'EndDecisionThen'};


    this.run = function() {

        //------------------------------------------------
        STEP('S39d10b5de2504d469162b63135eabcd5', '[1] IsDirectoryExist');
        RESULT = StepPlayer.Run('Desktop.IsDirectoryExist', this.isdirectoryexist_info_1);

        //------------------------------------------------
        STEP('S3f0c2d081c4145a68c81a9b43dd4469d', '[2] IfThen');
        if (RESULT == true) {

            //------------------------------------------------
            STEP('Sf201b3f138ca4c35a5e60956a24bad2c', '[3] DeleteDirectory');
            StepPlayer.Run('Desktop.DeleteDirectory', this.deletedirectory_info_3);

        //------------------------------------------------
        }
        STEP('S4048adec0ebd4be0aa21f786f51df1cc', '[4] End-IfThen');

        //------------------------------------------------
        STEP('Sd0adb78039be4ec0b6f0f821e7bd1e76', '[5] ReadTextFile');
        RESULT = StepPlayer.Run('Desktop.ReadTextFile', this.readtextfile_info_5);

        //------------------------------------------------
        STEP('S3ac7619ab025438fb6907a0163daef2a', '[6] ExecuteScript');
        RESULT = ToJson(RESULT)

        Global.Stockcode = []
        Global.Stock = []

        for (let i = 0; i < RESULT.details.length; i++) {
            const entry = RESULT.details[i];
            Global.Stockcode.push(entry.ticker);  // ticker를 Stockcode 배열에 추가
            Global.Stock.push(entry.name);        // name을 Stock 배열에 추가
        }



    }

    this.execute = function() {
        var result = null;
        result = this.run()
        if (result != null)
            return result;
    }
}
]]></JScript>
