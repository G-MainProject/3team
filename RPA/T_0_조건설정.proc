  <JScript><![CDATA[function T_0_조건설정() {

    this.RPAGOTOENABLE = false;
    this.GotoStepRetryCntMap = {};
    this.GotoBlockMap = {2:[4]};
    this.GotoReverseBlockMap = {4:2};
    this.GotoStepBlockTypeMap = {2:'DecisionThen',4:'EndDecisionThen'};


    this.run = function() {

        //------------------------------------------------
        STEP('S2c2ac43e3f9848bebdd2aee0ee274db0', '[1] IsDirectoryExist');
        RESULT = StepPlayer.Run('Desktop.IsDirectoryExist', this.isdirectoryexist_info_1);

        //------------------------------------------------
        STEP('S88ef9ec40a6943b2badfa1659434ab79', '[2] IfThen');
        if (RESULT != true) {

            //------------------------------------------------
            STEP('S9ceb77608fce450880ddd991ed501eb4', '[3] CreateDirectory');
            StepPlayer.Run('Desktop.CreateDirectory', this.createdirectory_info_3);

        //------------------------------------------------
        }
        STEP('S1f1e2146b0864ad5afc63a35be8ed0f2', '[4] End-IfThen');

        //------------------------------------------------
        STEP('Sd0adb78039be4ec0b6f0f821e7bd1e76', '[5] ReadTextFile');
        RESULT = StepPlayer.Run('Desktop.ReadTextFile', this.readtextfile_info_5);

        //------------------------------------------------
        STEP('S3ac7619ab025438fb6907a0163daef2a', '[6] ExecuteScript');
        const lines = RESULT.trim().split('\n') // 데이터 줄 단위로 분리

        // 첫 번째 줄은 헤더이므로, 두 번째 줄부터 시작
        for(let i = 1; i < lines.length; i++){
            const columns = lines[i].split(/\s+/)  // 공백 기준으로 각 열 분리
            Global.Stockcode.push(columns[0])
            Global.Stock.push(columns[1])
        }

        ////------------------------------------------------
        //STEP('Sd66e892961814157889f9fb6496251e0', '[7] InputBox');
        //Global.Stock = InputBox('','Text', '종목을 입력해세요', 0);

        ////------------------------------------------------
        //STEP('S9d0b82b540874fa5b8c2f1482b173d21', '[8] ExecuteScript');
