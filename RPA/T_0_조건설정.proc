      <Properties id="d21b931b-a768-4f74-9366-c0e434ebbf35" type="Flow">
        <Property type="Flow" key="Options_OnError" controlType="PropertyItemEventHandlerView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="" />
        <Property type="Flow" key="Key_Description" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="" />
        <Property type="Flow" key="Conditions_Title" controlType="String" valueType="System.String" formatType="String" required="True" visible="True" readonly="False" encrypted="False" isChanged="N" value="종목코드추출" />
        <Property type="Flow" key="Key_Script" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="const lines = RESULT.trim().split('\n') // 데이터 줄 단위로 분리&#xD;&#xA;&#xD;&#xA;// 첫 번째 줄은 헤더이므로, 두 번째 줄부터 시작&#xD;&#xA;for(let i = 1; i &lt; lines.length; i++){&#xD;&#xA;    const columns = lines[i].split(/\s+/)  // 공백 기준으로 각 열 분리&#xD;&#xA;    Global.Stockcode.push(columns[0])&#xD;&#xA;    Global.Stock.push(columns[1])&#xD;&#xA;}" />
      </Properties>
      <RelatedSteps />
      <Script><![CDATA[const lines = RESULT.trim().split('\n') // 데이터 줄 단위로 분리

// 첫 번째 줄은 헤더이므로, 두 번째 줄부터 시작
for(let i = 1; i < lines.length; i++){
    const columns = lines[i].split(/\s+/)  // 공백 기준으로 각 열 분리
    Global.Stockcode.push(columns[0])
    Global.Stock.push(columns[1])
}]]></Script>
    </Step>
