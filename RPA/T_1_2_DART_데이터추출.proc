            STEP('S48692e925351407c8663d29ee9d52db5', '[4] ExecuteScript');
            Global.Data_use = false

            //------------------------------------------------
            STEP('Sf42b9a3685884908b7b4c68900e0b346', '[5] ChromeClose');
            StepPlayer.Run('Chrome.ChromeClose', this.chromeclose_info_5);

            //------------------------------------------------
            STEP('Sd3ebd74bf57c41109cf4c0671241be8c', '[6] DeleteDirectory');
            StepPlayer.Run('Desktop.DeleteDirectory', this.deletedirectory_info_6);

            //------------------------------------------------
            STEP('Scfce82728edd45ff91b0a255cc2dd91a', '[7] TerminateFlow');
            return;

        //------------------------------------------------
        }else{
            STEP('S3f5b47f24c4843d09c9606cb8ec6ca4f', '[8] Else');

            //------------------------------------------------
            STEP('S035c15194e2c43378b4303edf87b3bc1', '[9] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_9);

            //------------------------------------------------
            STEP('S2b6c90c2d58d41b19757ac49db15a1d2', '[10] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_10);

            //------------------------------------------------
            STEP('Sd8e7fdb2db17420488e496326451dfa3', '[11] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_11);

            //------------------------------------------------
            STEP('S0d068f4114494346b05ddf5d881e5751', '[12] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_12);

            //------------------------------------------------
            STEP('S6f5e0acb929c4a438679368674f74def', '[13] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_13);

            //------------------------------------------------
            STEP('S8504b5e4b5e64846ae3e7e5fdecd725b', '[14] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_14);

            //------------------------------------------------
            STEP('S5687ac52073149b4901c578a65fcd2a7', '[15] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_15);

            //------------------------------------------------
            STEP('S2ff486eebd6141c1b646058f136a2d67', '[16] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_16);

            //------------------------------------------------
            STEP('S866143104ef84733b78b25bf67b7e224', '[17] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_17);

            //------------------------------------------------
            STEP('S2cdc6f78a513429093ccaf0f25a85e61', '[18] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_18);

            //------------------------------------------------
            STEP('Sc23823ae50ad4668b42213fddc860269', '[19] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_19);

            //------------------------------------------------
            STEP('S7c6372104cf54d9dba3e3388e862ef71', '[20] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_20);

            //------------------------------------------------
            STEP('S2f64f75c039c49808899e196e7a70df8', '[21] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_21);

            //------------------------------------------------
            STEP('Sa71db329fd0b46358ad611226588bc92', '[22] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_22);

            //------------------------------------------------
            STEP('S6cf493e39a7b4f64b4bf778caa0e6009', '[23] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_23);

            //------------------------------------------------
            STEP('Sea4d6e76f3d341fa970b40b0c4335609', '[24] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_24);

            //------------------------------------------------
            STEP('Sa992e82bb821497a8d03069648e2afa8', '[25] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_25);

            //------------------------------------------------
            STEP('S0280687a688e4fb599bca25f7c6e5cec', '[26] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_26);

            //------------------------------------------------
            STEP('S06f46333487f4d0891f78fce301f950f', '[27] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_27);

            //------------------------------------------------
            STEP('S0eaf2e0d6cbe49e29f4ff1085ae8f730', '[28] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_28);

            //------------------------------------------------
            STEP('S65a102c378d949768940f6196165fb2a', '[29] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_29);

            //------------------------------------------------
            STEP('S5e111b287a414abdb6a49420ba616543', '[30] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_30);

            //------------------------------------------------
            STEP('S3bb7f7ebdb39441aa99375503f9c36d0', '[31] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_31);

            //------------------------------------------------
            STEP('Sb799354eff6c42d48f425f716e9c61e7', '[32] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_32);

            //------------------------------------------------
            STEP('S4d366200d41f41388ce957e8460ed9eb', '[33] ChromeSetCheckState');
            StepPlayer.Run('Chrome.ChromeSetCheckState', this.chromesetcheckstate_info_33);

            //------------------------------------------------
            STEP('Scf7664df48b74522a917196db358f2cd', '[34] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_34);

            //------------------------------------------------
            STEP('S202517eb905e4777a2c7a6086dbbcf18', '[35] ChromeClick');
            StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_35);

            //------------------------------------------------
            STEP('Se40ddd4bbeb448f7a890e01554ed7798', '[36] Delay');
            Delay(100);

            //------------------------------------------------
            STEP('S0fda1c8701c247b3b4bf18d6ea1d8be5', '[37] ChromeGetMultipleElements');
            this.DART_id = StepPlayer.Run('Chrome.ChromeGetMultipleElements', this.chromegetmultipleelements_info_37);

            //------------------------------------------------
            STEP('Sf0e74b88e3f64056b93d998707bfb0f6', '[38] ExecuteScript');
            if(this.DART_id.length > 10) {
                this.DART_index = 10
            }else {
                this.DART_index = this.DART_id.length
            }

            Global.Data_use = true

            //------------------------------------------------
            STEP('Sd54e68b3236542af9fe53abc4f53b8dc', '[39] For');
            for (this.i = 0; this.i < this.DART_index; this.i++) {

                //------------------------------------------------
                STEP('S23c6aa82887e46baa6166fdd13956980', '[40] ChromeClick');
                StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_40);

                //------------------------------------------------
                STEP('Sf02c71c1f2074ff28f8de002fcb31df0', '[41] IsVisible');
                this.popup_IsVisible = StepPlayer.Run('Win.IsVisible', this.isvisible_info_41);

                //------------------------------------------------
                STEP('S7732bf51657248d289a76187de07ddb4', '[42] IfThen');
                if (this.popup_IsVisible == true) {

                    //------------------------------------------------
                    STEP('S91f78c2c2fbd425995a3af7d65eeab21', '[43] ChromeClick');
                    StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_43);

                //------------------------------------------------
                }
                STEP('Sb9ba4413eaf74a95a494bd7b3b4c9364', '[44] End-IfThen');

                //------------------------------------------------
                STEP('Sa8bfc0967d0140bcb2963a77390e9565', '[45] IsVisible');
                this.download_btn_IsVisible = StepPlayer.Run('Win.IsVisible', this.isvisible_info_45);

                //------------------------------------------------
                STEP('S4cfa3799c9ca4c4286e1a9695ba04b08', '[46] Delay');
                Delay(1000);

                //------------------------------------------------
                STEP('S68f63a5aad204e05b9ebe11f5015e1c5', '[47] IfElse');
                if (this.download_btn_IsVisible == true) {

                    //------------------------------------------------
                    STEP('S239b734ee70846a588d2687264633d27', '[48] ChromeClick');
                    StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_48);

                //------------------------------------------------
                }else{
                    STEP('S0ee3bee647df455d83b28e65e9f2b7c0', '[49] Else');

                    //------------------------------------------------
                    STEP('Sb36cdba00ff6480ca597a6a14b28669a', '[50] ChromeClick');
                    StepPlayer.Run('Chrome.ChromeClick', this.chromeclick_info_50);

                //------------------------------------------------
                }
                STEP('S754ab3cd0b9c41258d39182d827728fb', '[51] End-IfElse');

                //------------------------------------------------
                STEP('Sc0682dbea6b944c793205025fc00d72c', '[52] GetText');
                RESULT = StepPlayer.Run('Win.GetText', this.gettext_info_52);

                //------------------------------------------------
                STEP('S747bf51356e3403090e74e9b55e9d912', '[53] ExecuteScript');
                const part = RESULT.split('.do?')
                this.DART_File_path = part.length > 1 ? part[1].trim() : null

                //------------------------------------------------
                STEP('Sd52dbf31fea14592baa486cdf67a8b03', '[54] ChromeGetListData');
                RESULT = StepPlayer.Run('Chrome.ChromeGetListData', this.chromegetlistdata_info_54);

                //------------------------------------------------
                STEP('S42512a56a47945a28d2e11f8dce667b5', '[55] ExecuteScript');
                // 파일명\t다운로드 포함되어있는 인덱스 추출
                let index = -1

                for (let i = 0; i < RESULT.length; i++) {
                    if (RESULT[i].includes('파일명\t다운로드')) {
                        index = i
                        break
                    }
                }

                // 파일 이름 저장
                if (index !== -1) {
                    const nextLines = RESULT[index].split('\n')
                    const file = nextLines.map(line => line.trim())
                    file_cpy = file[1]

                    // 파일이름 저장
                    const nameParts = file_cpy.split('.')
                    Global.DART_File_name[this.i] = nameParts.slice(0, -1).join('.')
                    
                    // 확장자 저장
                    const fileName = nameParts.slice(0, nameParts.length).join('.')
                    const type = fileName.split(').')
                    Global.DART_File_type[this.i] = type.length > 1 ? type[1].trim() : null
                }

                //------------------------------------------------
                STEP('Sf458f83d08064936a3093f51fa420582', '[56] Click');
                try{
                    StepPlayer.Run('Win.Click', this.click_info_56);
                }catch(e){
                    Warn('CatchException: ' + e.message);
                }


                //------------------------------------------------
                STEP('Se79b76f279ba4d12842bfdca9d208afb', '[57] IsVisible');
                download_isvisible = StepPlayer.Run('Win.IsVisible', this.isvisible_info_57);

                //------------------------------------------------
                STEP('S036a1a180df2405ca1f70dcd8e80bf9c', '[58] IfThen');
                if (download_isvisible == true) {

                    //------------------------------------------------
                    STEP('Sf47735335b8e40c482e842ef664e3b3f', '[59] IfThen');
                    if (this.DART_flag == true) {

                        //------------------------------------------------
                        STEP('Sa3037b3d28174bab8cff06392cd4ab74', '[60] Click');
                        StepPlayer.Run('Win.Click', this.click_info_60);

                        //------------------------------------------------
                        STEP('S49d2b788c03346ff96b5fe69d59b908a', '[61] ExecuteScript');
                        this.tmp = Global.file_path + '\\DART\\' + Global.Stock[Global.DATE_I] +'\\pdf'
                        this.DART_flag = false

                        //------------------------------------------------
                        STEP('S57d6f350751b438694909d95cf5547f7', '[62] KeyInput');
                        StepPlayer.Run('Win.KeyInput', this.keyinput_info_62);

                    //------------------------------------------------
                    }
                    STEP('S02a98be601534b8c9361f2a404c15ffb', '[63] End-IfThen');

                    //------------------------------------------------
                    STEP('S1164701d567543379810aea6339a3da0', '[64] Click');
                    StepPlayer.Run('Win.Click', this.click_info_64);

                //------------------------------------------------
                }
                STEP('S1d0d8733d9494e9787402cbd17ac6590', '[65] End-IfThen');

                //------------------------------------------------
                STEP('Saa0701cd4e11492599910b3390c68e4c', '[66] KeyInput');
                StepPlayer.Run('Win.KeyInput', this.keyinput_info_66);

                //------------------------------------------------
                STEP('S1e51e20199cc46a18d4b236c15c5ed92', '[67] KeyInput');
                StepPlayer.Run('Win.KeyInput', this.keyinput_info_67);

            //------------------------------------------------
            }
            STEP('S3843cd1c55dc4b4d8e683d2ad159fe7c', '[68] End-For');

            //------------------------------------------------
            STEP('Sa5b8abbbf964490585d9b7718af9956a', '[69] ChromeClose');
            StepPlayer.Run('Chrome.ChromeClose', this.chromeclose_info_69);

        //------------------------------------------------
        }
        STEP('S581293b962bd49c689bd3c8e572005af', '[70] End-IfElse');


    }

    this.execute = function() {
        var result = null;
        result = this.run()
        if (result != null)
            return result;
    }
}
