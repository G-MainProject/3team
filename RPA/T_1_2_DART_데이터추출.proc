    this.GotoStepBlockTypeMap = {3:'Decision',8:'Else',70:'EndDecision',39:'Loop',68:'EndLoop',42:'DecisionThen',44:'EndDecisionThen',47:'Decision',49:'Else',51:'EndDecision',58:'DecisionThen',65:'EndDecisionThen',59:'DecisionThen',63:'EndDecisionThen'};


    this.run = function() {

