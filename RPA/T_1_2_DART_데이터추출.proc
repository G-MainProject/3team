    <Step id="S42512a56a47945a28d2e11f8dce667b5" ver="311241220" createVer="311241220" type="Flow" name="ExecuteScript" dpName="ExecuteScript" dpValue="" dpValue2="" dpImage="" tag="" depth="3" stmttype="Normal" enabled="True" mainSet="0">
      <Properties id="21ce94c9-338b-46c3-b22d-8dec7eaf55a4" type="Flow">
        <Property type="Flow" key="Options_OnError" controlType="PropertyItemEventHandlerView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="" />
        <Property type="Flow" key="Key_Description" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="" />
        <Property type="Flow" key="Conditions_Title" controlType="String" valueType="System.String" formatType="String" required="True" visible="True" readonly="False" encrypted="False" isChanged="N" value="파일명설정" />
        <Property type="Flow" key="Key_Script" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="// 파일명\t다운로드 포함되어있는 인덱스 추출&#xD;&#xA;let index = -1&#xD;&#xA;&#xD;&#xA;for (let i = 0; i &lt; RESULT.length; i++) {&#xD;&#xA;    if (RESULT[i].includes('파일명\t다운로드')) {&#xD;&#xA;        index = i&#xD;&#xA;        break&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 파일 이름 저장&#xD;&#xA;if (index !== -1) {&#xD;&#xA;    const nextLines = RESULT[index].split('\n')&#xD;&#xA;    const file = nextLines.map(line =&gt; line.trim())&#xD;&#xA;    file_cpy = file[1]&#xD;&#xA;&#xD;&#xA;    // 파일이름 저장&#xD;&#xA;    const nameParts = file_cpy.split('.')&#xD;&#xA;    Global.DART_File_name[this.i] = nameParts.slice(0, -1).join('.')&#xD;&#xA;    &#xD;&#xA;    // 확장자 저장&#xD;&#xA;    const fileName = nameParts.slice(0, nameParts.length).join('.')&#xD;&#xA;    const type = fileName.split(').')&#xD;&#xA;    Global.DART_File_type[this.i] = type.length &gt; 1 ? type[1].trim() : null&#xD;&#xA;}" />
      </Properties>
      <RelatedSteps />
      <Script><![CDATA[// 파일명\t다운로드 포함되어있는 인덱스 추출
let index = -1

for (let i = 0; i < RESULT.length; i++) {
    if (RESULT[i].includes('파일명\t다운로드')) {
        index = i
        break
    }
}

// 파일 이름 저장
if (index !== -1) {
    const nextLines = RESULT[index].split('\n')
    const file = nextLines.map(line => line.trim())
    file_cpy = file[1]

    // 파일이름 저장
    const nameParts = file_cpy.split('.')
    Global.DART_File_name[this.i] = nameParts.slice(0, -1).join('.')
    
    // 확장자 저장
    const fileName = nameParts.slice(0, nameParts.length).join('.')
    const type = fileName.split(').')
    Global.DART_File_type[this.i] = type.length > 1 ? type[1].trim() : null
}]]></Script>
    </Step>
