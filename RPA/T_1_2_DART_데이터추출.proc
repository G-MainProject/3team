  <JScript><![CDATA[function T_1_2_DART_데이터추출() {

    this.DART_flag = true;
    this.download_btn_IsVisible;
    this.popup_IsVisible;
    this.search_IsVisible;
    this.tmp;
    this.DART_id;
    this.DART_File_path;
    this.DART_index;

    this.RPAGOTOENABLE = false;
