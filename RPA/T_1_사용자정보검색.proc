            //------------------------------------------------
            STEP('Sc27820f5c65f449b842998eca52ff372', '[49] EndSwitchCase');
            break;
            }

            //------------------------------------------------
            case '날짜':{ 
            STEP('S2bfd88c30d06478c8233959a76da8726', '[50] SwitchCase');

                //------------------------------------------------
                STEP('S251252bf7a65416bbbc723cc4aa66e75', '[51] KeyInput');
                StepPlayer.Run('Win.KeyInput', this.keyinput_info_51);

                //------------------------------------------------
                STEP('S3a556b8056794de883e93f9143ef6dc0', '[52] ChromeSetText');
