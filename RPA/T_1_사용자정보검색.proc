            STEP('S6097e8ee6a514daababb0d1b041a2a1f', '[41] SwitchCase');

                //------------------------------------------------
                STEP('S8859a9a05e8249d89df6e8fe3b4cd507', '[42] KeyInput');
                StepPlayer.Run('Win.KeyInput', this.keyinput_info_42);

                //------------------------------------------------
                STEP('S54d0f5b138684772a85ae41de73fca3a', '[43] Click');
                StepPlayer.Run('Win.Click', this.click_info_43);

                //------------------------------------------------
                STEP('S947f51ef0051440c887723659c78c4e0', '[44] For');
                for (this.i = 0; this.i < this.SecuritiesData; this.i++) {

                    //------------------------------------------------
                    STEP('Sd1b3d766b906410db87192aff4d620ee', '[45] KeyInput');
                    StepPlayer.Run('Win.KeyInput', this.keyinput_info_45);

                //------------------------------------------------
                }
                STEP('Sba516298e38f4f6a99cc19a022d176d5', '[46] End-For');

                //------------------------------------------------
                STEP('S8750f4a6a5d34005885db0168c952f6f', '[47] KeyInput');
