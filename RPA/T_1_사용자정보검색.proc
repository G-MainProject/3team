                      "한국기업데이터": 31,
                      "한국기업평가": 32,
                      "한국투자증권": 33,
                      "한양증권": 34,
                      "한화투자증권": 35,
                      "현대차증권": 36,
                    };


                    this.SecuritiesData = securitiesData[this.Securities] || null

                    if(this.SecuritiesData == null) {
                        this.Search = 'default'
                    }

                //------------------------------------------------
                }
                STEP('Sc8a529d4b640432a80db9c7bb82f11fd', '[18] End-IfThen');

            //------------------------------------------------
            STEP('S45dd0928570b4cff9db8d71bc0af0adc', '[19] EndSwitchCase');
            break;
            }

            //------------------------------------------------
            case '날짜':{ 
            STEP('Se36fcbde8d884b80a7f24183a5f7f47e', '[20] SwitchCase');

                //------------------------------------------------
                STEP('S25aa62cb1d994a2286e216cb5e5b73a3', '[21] ExecuteScript');
                //실행 날짜만 추출 ex_2023-04-06T01:36:04.442Z
                this.Date_start = new Date().toISOString().slice(0, 10);
                this.Date_end = new Date().toISOString().slice(0, 10);


                //------------------------------------------------
                STEP('S8f8f18de505e4798a74b6eb63b7d93f5', '[22] InputBox');
                this.Date_start = InputBox(this.Date_start,'Text', '검색할 데이터의 시작할 날짜를 입력해세요', 0);

                //------------------------------------------------
                STEP('Sc073b1923ebd4972a253031c6d0ccde4', '[23] InputBox');
                this.Date_end = InputBox(this.Date_end,'Text', '검색할 데이터의 끝 날짜를 입력해세요', 0);

                //------------------------------------------------
                STEP('S2d51764f610345ee8d72e3df557ae889', '[24] IfThen');
                if ((this.Date_start == '') || (this.Date_end== '')) {

                    //------------------------------------------------
                    STEP('S5aa8807aeb3941b5aecb411976e84d6e', '[25] ExecuteScript');
                    this.Search = 'default'

                //------------------------------------------------
                }
                STEP('Sa8b54c059fe34c768e42386f6cb94d3c', '[26] End-IfThen');

            //------------------------------------------------
            STEP('S23d232cf3ba8402496f64ae2951010ed', '[27] EndSwitchCase');
            break;
            }

            //------------------------------------------------
            default:{ 
            STEP('Sdc0c399f97724c3495521a8a4a3400d7', '[28] SwitchDefault');

            //------------------------------------------------
            STEP('Sf7c071d031c24207ba0ec495aae0141e', '[29] EndSwitchDefault');
            break;
            }

        }

        //------------------------------------------------
        STEP('Sef9f5f6f105b40a181a1b13e8a0f86e8', '[30] ChromeOpen');
