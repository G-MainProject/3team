                //------------------------------------------------
                }else{
                    STEP('S71bc04b0d41e4be4ad1425282fd7effc', '[55] Else');

                    //------------------------------------------------
                    STEP('S229851bc2243412aaab555d526e634a3', '[56] ChromeSetText');
                    StepPlayer.Run('Chrome.ChromeSetText', this.chromesettext_info_56);

                //------------------------------------------------
                }
                STEP('Sf8e1cc141d4d403aa223a7918837b3c7', '[57] End-IfElse');

                //------------------------------------------------
                STEP('S9dd671bd6a0648fdba5b5e350dd63e44', '[58] Click');
                StepPlayer.Run('Win.Click', this.click_info_58);

            //------------------------------------------------
            STEP('S8aef42a49cc44b4a8883be159486f35d', '[59] EndSwitchCase');
