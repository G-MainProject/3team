        STEP('Sd1000b8a64234d6b86cac385f9474954', '[31] KeyInput');
        StepPlayer.Run('Win.KeyInput', this.keyinput_info_31);

        //------------------------------------------------
        STEP('Se3af94e0e7b543158b390fcc88b0d799', '[32] SwitchGroup');
        switch (this.Search) {

            //------------------------------------------------
            case '종목':{ 
            STEP('S52c1cd286787448d9b9878de702916fa', '[33] SwitchCase');

