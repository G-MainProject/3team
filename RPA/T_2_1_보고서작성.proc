    <Step id="S2108a361006f45b9a8c79c53e0d8eebe" ver="311241220" createVer="311241220" type="Flow" name="ExecuteScript" dpName="ExecuteScript" dpValue="" dpValue2="" dpImage="" tag="" depth="1" stmttype="Normal" enabled="True" mainSet="0">
      <Properties id="1f1d216d-4737-4845-8f2f-5f9d8f2e7ee5" type="Flow">
        <Property type="Flow" key="Options_OnError" controlType="PropertyItemEventHandlerView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="" />
        <Property type="Flow" key="Key_Description" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="" />
        <Property type="Flow" key="Conditions_Title" controlType="String" valueType="System.String" formatType="String" required="True" visible="True" readonly="False" encrypted="False" isChanged="N" value="보고서 제목및 항목 설정" />
        <Property type="Flow" key="Key_Script" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="//엑셀기준 B8 = (0, 0)&#xD;&#xA;&#xD;&#xA;this.top_mover_forecast = ToJson(this.top_mover_forecast)&#xD;&#xA;this.sentiment_report = ToJson(this.sentiment_report)&#xD;&#xA;this.Gemini_Api = ToJson(this.Gemini_Api)&#xD;&#xA;&#xD;&#xA;// 각 섹션별 시작 열 인덱스 배열&#xD;&#xA;const sections = [1, 29, 57, 65, 73, 82]&#xD;&#xA;&#xD;&#xA;// 초기화&#xD;&#xA;for (let i = 0; i &lt;= 87; i++) {&#xD;&#xA;    this.subject[i] = []&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;for (let idx = 0; idx &lt; sections.length; idx++) {&#xD;&#xA;    let row = sections[idx]&#xD;&#xA;    this.subject[row][0] = 'No'&#xD;&#xA;    this.subject[row][1] = '종목명'&#xD;&#xA;    this.subject[row][2] = '종목코드'&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 종목 및 종목코드 입력&#xD;&#xA;for (let s = 0; s &lt; sections.length; s++) {&#xD;&#xA;    let base = sections[s] + 1&#xD;&#xA;    &#xD;&#xA;    //기술적 지표&#xD;&#xA;    if(s == 4) {&#xD;&#xA;        base += 1&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    for (let i = 0; i &lt; this.top_mover_forecast.entries.length; i++) {&#xD;&#xA;        let entry = this.top_mover_forecast.entries[i]&#xD;&#xA;        //기간별 예측값 / AI분석&#xD;&#xA;        let row = base + i&#xD;&#xA;        &#xD;&#xA;        this.subject[row][0] = i + 1&#xD;&#xA;        this.subject[row][1] = entry.name&#xD;&#xA;        this.subject[row][2] = '\'' + entry.ticker&#xD;&#xA;        &#xD;&#xA;        if(s &lt; 2){&#xD;&#xA;            base += 4&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 제목 &#xD;&#xA;this.subject[sections[0] - 1][0] = '기간별 예측값'&#xD;&#xA;this.subject[sections[1] - 1][0] = 'AI분석'&#xD;&#xA;this.subject[sections[2] - 1][0] = '기준 시점 주가 및 거래량'&#xD;&#xA;this.subject[sections[3] - 1][0] = '재무제표'&#xD;&#xA;this.subject[sections[4] - 1][0] = '기술적 지표'&#xD;&#xA;this.subject[sections[5] - 1][0] = '뉴스 감정분석'&#xD;&#xA;&#xD;&#xA;// 기간별 예측값&#xD;&#xA;this.subject[sections[0]][3] = '기간'&#xD;&#xA;this.subject[sections[0]][4] = '예측 가격'&#xD;&#xA;this.subject[sections[0]][5] = '실제 가격'&#xD;&#xA;this.subject[sections[0]][6] = '가격 절대오차'&#xD;&#xA;this.subject[sections[0]][7] = '예측 수익률'&#xD;&#xA;this.subject[sections[0]][8] = '실제 수익률'&#xD;&#xA;this.subject[sections[0]][9] = '수익률 절대오차'&#xD;&#xA;this.subject[sections[0]][14] = '비고'&#xD;&#xA;&#xD;&#xA;// AI 분석&#xD;&#xA;this.subject[sections[1]][3] = '기간'&#xD;&#xA;this.subject[sections[1]][4] = '판정'&#xD;&#xA;this.subject[sections[1]][5] = '요약'&#xD;&#xA;this.subject[sections[1]][14] = '비고'&#xD;&#xA;&#xD;&#xA;// 기준 시점 주가 및 거래량&#xD;&#xA;this.subject[sections[2]][3] = '기준가(현재가)'&#xD;&#xA;this.subject[sections[2]][4] = '전일 대비'&#xD;&#xA;this.subject[sections[2]][5] = '거래량'&#xD;&#xA;this.subject[sections[2]][6] = '시가총액'&#xD;&#xA;this.subject[sections[2]][14] = '비고'&#xD;&#xA;&#xD;&#xA;// 제무제표&#xD;&#xA;this.subject[sections[3]][3] = '매출액'&#xD;&#xA;this.subject[sections[3]][4] = '영업이익'&#xD;&#xA;this.subject[sections[3]][5] = '당기순이익'&#xD;&#xA;this.subject[sections[3]][6] = 'PER'&#xD;&#xA;this.subject[sections[3]][7] = 'PBR'&#xD;&#xA;this.subject[sections[3]][8] = 'ROE'&#xD;&#xA;this.subject[sections[3]][9] = 'ROA'&#xD;&#xA;this.subject[sections[3]][10] = '부채비율'&#xD;&#xA;this.subject[sections[3]][11] = '유동비율'&#xD;&#xA;this.subject[sections[3]][12] = '당좌비율'&#xD;&#xA;this.subject[sections[3]][13] = '자기자본비율'&#xD;&#xA;this.subject[sections[3]][14] = '비고'&#xD;&#xA;&#xD;&#xA;// 기술적 지표&#xD;&#xA;this.subject[sections[4]][3] = 'RSI'&#xD;&#xA;this.subject[sections[4]][5] = 'OBV'&#xD;&#xA;this.subject[sections[4]][6] = 'MACD'&#xD;&#xA;this.subject[sections[4]][7] = '볼린저밴드'&#xD;&#xA;this.subject[sections[4]][14] = '비고'&#xD;&#xA;this.subject[sections[4] + 1][7] = '상단'&#xD;&#xA;this.subject[sections[4] + 1][8] = '중단'&#xD;&#xA;this.subject[sections[4] + 1][9] = '하단'&#xD;&#xA;&#xD;&#xA;//뉴스 감정분석&#xD;&#xA;this.subject[sections[5]][3] = '전반적인 심리'&#xD;&#xA;this.subject[sections[5]][4] = '평균 심리 점수'&#xD;&#xA;this.subject[sections[5]][5] = '긍정 건수'&#xD;&#xA;this.subject[sections[5]][6] = '중립 건수'&#xD;&#xA;this.subject[sections[5]][7] = '부정 건수'&#xD;&#xA;this.subject[sections[5]][8] = '핵심 키워드 5가지'&#xD;&#xA;this.subject[sections[5]][14] = '비고'&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;let keys_array = []&#xD;&#xA;let wordCloud = '없음'&#xD;&#xA;&#xD;&#xA;let dateRanges = ['1일', '1주일', '1개월', '6개월', '1년'];&#xD;&#xA;let bass&#xD;&#xA;&#xD;&#xA;// 기간별 예측값&#xD;&#xA;for(let i = 0; i &lt; this.top_mover_forecast.entries.length; i++) {&#xD;&#xA;    let entry = this.top_mover_forecast.entries[i]&#xD;&#xA;    &#xD;&#xA;    bass = 4 * i + i &#xD;&#xA;    let row = sections[0] + 1 + bass&#xD;&#xA;    for(let s = 0; s &lt; entry.horizons.length; s++) {&#xD;&#xA;        if (entry.horizons[s].horizon == '1d') {&#xD;&#xA;            this.subject[row][3] = dateRanges[0]&#xD;&#xA;        }else if (entry.horizons[s].horizon == '1w') {&#xD;&#xA;            this.subject[row][3] = dateRanges[1]&#xD;&#xA;        }else if (entry.horizons[s].horizon == '1m') {&#xD;&#xA;            this.subject[row][3] = dateRanges[2]&#xD;&#xA;        }else if (entry.horizons[s].horizon == '6m') {&#xD;&#xA;            this.subject[row][3] = dateRanges[3]&#xD;&#xA;        }else if (entry.horizons[s].horizon == '1y') {&#xD;&#xA;            this.subject[row][3] = dateRanges[4]&#xD;&#xA;        }else {&#xD;&#xA;            this.subject[row][3] = '그 외'&#xD;&#xA;        }&#xD;&#xA;        &#xD;&#xA;        this.subject[row][4] = entry.horizons[s].predicted_price&#xD;&#xA;        this.subject[row][5] = entry.horizons[s].actual_price&#xD;&#xA;        this.subject[row][6] = entry.horizons[s].abs_error&#xD;&#xA;        this.subject[row][7] = entry.horizons[s].predicted_return&#xD;&#xA;        this.subject[row][8] = entry.horizons[s].actual_return&#xD;&#xA;        this.subject[row][9] = entry.horizons[s].return_abs_error&#xD;&#xA;        &#xD;&#xA;        row++&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// AI 분석&#xD;&#xA;let keys = Object.keys(this.Gemini_Api.stocks)&#xD;&#xA;&#xD;&#xA;for (let i = 0; i &lt; keys.length; i++) {&#xD;&#xA;    let bass = 4 * i + i &#xD;&#xA;    let row = sections[1] + 1 + bass&#xD;&#xA;    let periodKey = Object.keys(this.Gemini_Api.stocks[keys[i]].periods)&#xD;&#xA;&#xD;&#xA;    for (let s = 0; s &lt; periodKey.length; s++) {&#xD;&#xA;        this.subject[row][3] = dateRanges[s]&#xD;&#xA;        this.subject[row][4] = this.Gemini_Api.stocks[keys[i]].periods[periodKey[s]].verdict&#xD;&#xA;        this.subject[row][5] = this.Gemini_Api.stocks[keys[i]].periods[periodKey[s]].text&#xD;&#xA;&#xD;&#xA;        row++;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;for (let i = 0; i &lt; this.top_mover_forecast.entries.length; i++) {&#xD;&#xA;    let entry = this.top_mover_forecast.entries[i]&#xD;&#xA;    &#xD;&#xA;    // 기준 시점 주가 및 거래량&#xD;&#xA;    row = sections[2] + 1 + i &#xD;&#xA;    this.subject[row][3] = entry.current_price&#xD;&#xA;    this.subject[row][4] = entry.change_pct + '%'&#xD;&#xA;    this.subject[row][5] = entry.indicators.obv&#xD;&#xA;    this.subject[row][6] = entry.fundamentals.market_cap&#xD;&#xA;&#xD;&#xA;    // 재무제표&#xD;&#xA;    row = sections[3] + 1 + i &#xD;&#xA;    this.subject[row][3] = entry.fundamentals.fund_revenue&#xD;&#xA;    this.subject[row][4] = entry.fundamentals.fund_operating_income&#xD;&#xA;    this.subject[row][5] = entry.fundamentals.fund_net_income&#xD;&#xA;    this.subject[row][6] = Math.round(entry.fundamentals.per * 100) / 100&#xD;&#xA;    this.subject[row][7] = Math.round(entry.fundamentals.pbr * 100) / 100&#xD;&#xA;    this.subject[row][8] = entry.fundamentals.roe&#xD;&#xA;    this.subject[row][9] = entry.fundamentals.roa&#xD;&#xA;    this.subject[row][10] = Math.round(entry.fundamentals.debt_ratio * 100) / 100 + '%'&#xD;&#xA;    this.subject[row][11] = Math.round(entry.fundamentals.current_ratio * 100) / 100 + '%'&#xD;&#xA;    this.subject[row][12] = Math.round(entry.fundamentals.quick_ratio * 100) / 100 + '%'&#xD;&#xA;    this.subject[row][13] = Math.round(entry.fundamentals.equity_ratio * 100) / 100 + '%'&#xD;&#xA;&#xD;&#xA;    // 기술적 지표&#xD;&#xA;    row = sections[4] + 2 + i &#xD;&#xA;    this.subject[row][3] = Math.round(entry.indicators.rsi)&#xD;&#xA;    &#xD;&#xA;    let rsi_level&#xD;&#xA;    if(this.subject[row][3] &gt;= 71) {&#xD;&#xA;        rsi_level = '과매수'&#xD;&#xA;    }else if((this.subject[row][3] &gt;= 61) &amp;&amp; (this.subject[row][3] &lt;= 70)){&#xD;&#xA;        rsi_level = '과매수 경계'&#xD;&#xA;    }else if((this.subject[row][3] &gt;= 41) &amp;&amp; (this.subject[row][3] &lt;= 60)){&#xD;&#xA;        rsi_level = '중립'&#xD;&#xA;    }else if((this.subject[row][3] &gt;= 31) &amp;&amp; (this.subject[row][3] &lt;= 40)){&#xD;&#xA;        rsi_level = '과매도 경계'&#xD;&#xA;    }else if (this.subject[row][3] &lt;= 30){&#xD;&#xA;        rsi_level = '과매도'&#xD;&#xA;    }else {&#xD;&#xA;        rsi_level = '없음'&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    this.subject[row][4] = rsi_level&#xD;&#xA;    this.subject[row][5] = entry.indicators.obv&#xD;&#xA;    this.subject[row][6] = entry.indicators.macd&#xD;&#xA;    this.subject[row][7] = entry.indicators.bb_upper&#xD;&#xA;    this.subject[row][8] = entry.indicators.bb_mid&#xD;&#xA;    this.subject[row][9] = entry.indicators.bb_lower&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// 키워드 상위 5개&#xD;&#xA;for(let i = 0; i &lt; this.sentiment_report.length; i++) {&#xD;&#xA;    wordCloud = this.sentiment_report[i].keywordAnalysis.wordCloud&#xD;&#xA;    if(wordCloud == '없음') {&#xD;&#xA;        break;&#xD;&#xA;    }&#xD;&#xA;    let keys = '';&#xD;&#xA;    let count = 0;&#xD;&#xA;&#xD;&#xA;    for (const key in wordCloud) {&#xD;&#xA;        if (count === 5) {&#xD;&#xA;            break;&#xD;&#xA;        }&#xD;&#xA;        &#xD;&#xA;        if (keys !== '') {&#xD;&#xA;            keys += ', ';&#xD;&#xA;        }&#xD;&#xA;        &#xD;&#xA;        keys += key;&#xD;&#xA;        count++;&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    keys_array[i] = keys&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;for (let i = 0; i &lt; this.sentiment_report.length; i++) {&#xD;&#xA;    let row = sections[5] + 1 + i &#xD;&#xA;    this.subject[row][3] = this.sentiment_report[i].sentimentAnalysis.overallSentiment &#xD;&#xA;    this.subject[row][4] = this.sentiment_report[i].sentimentAnalysis.averageScore &#xD;&#xA;    this.subject[row][5] = this.sentiment_report[i].sentimentAnalysis.sentimentDistribution.positive &#xD;&#xA;    this.subject[row][6] = this.sentiment_report[i].sentimentAnalysis.sentimentDistribution.neutral &#xD;&#xA;    this.subject[row][7] = this.sentiment_report[i].sentimentAnalysis.sentimentDistribution.negative&#xD;&#xA;    this.subject[row][8] = keys_array[i]&#xD;&#xA;    &#xD;&#xA;    for(let j = 3; j &lt; 9; j++) {&#xD;&#xA;        if(this.subject[row][j] == undefined) {&#xD;&#xA;            this.subject[row][j] = 0&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;" />
      </Properties>
      <RelatedSteps />
      <Script><![CDATA[//엑셀기준 B8 = (0, 0)

this.top_mover_forecast = ToJson(this.top_mover_forecast)
this.sentiment_report = ToJson(this.sentiment_report)
this.Gemini_Api = ToJson(this.Gemini_Api)

// 각 섹션별 시작 열 인덱스 배열
const sections = [1, 29, 57, 65, 73, 82]

// 초기화
for (let i = 0; i <= 87; i++) {
    this.subject[i] = []
}


for (let idx = 0; idx < sections.length; idx++) {
    let row = sections[idx]
    this.subject[row][0] = 'No'
    this.subject[row][1] = '종목명'
    this.subject[row][2] = '종목코드'
}

// 종목 및 종목코드 입력
for (let s = 0; s < sections.length; s++) {
    let base = sections[s] + 1
    
    //기술적 지표
    if(s == 4) {
        base += 1
    }
    
    for (let i = 0; i < this.top_mover_forecast.entries.length; i++) {
        let entry = this.top_mover_forecast.entries[i]
        //기간별 예측값 / AI분석
        let row = base + i
        
        this.subject[row][0] = i + 1
        this.subject[row][1] = entry.name
        this.subject[row][2] = '\'' + entry.ticker
        
        if(s < 2){
            base += 4
        }
    }
}

// 제목 
this.subject[sections[0] - 1][0] = '기간별 예측값'
this.subject[sections[1] - 1][0] = 'AI분석'
this.subject[sections[2] - 1][0] = '기준 시점 주가 및 거래량'
this.subject[sections[3] - 1][0] = '재무제표'
this.subject[sections[4] - 1][0] = '기술적 지표'
this.subject[sections[5] - 1][0] = '뉴스 감정분석'

// 기간별 예측값
this.subject[sections[0]][3] = '기간'
this.subject[sections[0]][4] = '예측 가격'
this.subject[sections[0]][5] = '실제 가격'
this.subject[sections[0]][6] = '가격 절대오차'
this.subject[sections[0]][7] = '예측 수익률'
this.subject[sections[0]][8] = '실제 수익률'
this.subject[sections[0]][9] = '수익률 절대오차'
this.subject[sections[0]][14] = '비고'

// AI 분석
this.subject[sections[1]][3] = '기간'
this.subject[sections[1]][4] = '판정'
this.subject[sections[1]][5] = '요약'
this.subject[sections[1]][14] = '비고'

// 기준 시점 주가 및 거래량
this.subject[sections[2]][3] = '기준가(현재가)'
this.subject[sections[2]][4] = '전일 대비'
this.subject[sections[2]][5] = '거래량'
this.subject[sections[2]][6] = '시가총액'
this.subject[sections[2]][14] = '비고'

// 제무제표
this.subject[sections[3]][3] = '매출액'
this.subject[sections[3]][4] = '영업이익'
this.subject[sections[3]][5] = '당기순이익'
this.subject[sections[3]][6] = 'PER'
this.subject[sections[3]][7] = 'PBR'
this.subject[sections[3]][8] = 'ROE'
this.subject[sections[3]][9] = 'ROA'
this.subject[sections[3]][10] = '부채비율'
this.subject[sections[3]][11] = '유동비율'
this.subject[sections[3]][12] = '당좌비율'
this.subject[sections[3]][13] = '자기자본비율'
this.subject[sections[3]][14] = '비고'

// 기술적 지표
this.subject[sections[4]][3] = 'RSI'
this.subject[sections[4]][5] = 'OBV'
this.subject[sections[4]][6] = 'MACD'
this.subject[sections[4]][7] = '볼린저밴드'
this.subject[sections[4]][14] = '비고'
this.subject[sections[4] + 1][7] = '상단'
this.subject[sections[4] + 1][8] = '중단'
this.subject[sections[4] + 1][9] = '하단'

//뉴스 감정분석
this.subject[sections[5]][3] = '전반적인 심리'
this.subject[sections[5]][4] = '평균 심리 점수'
this.subject[sections[5]][5] = '긍정 건수'
this.subject[sections[5]][6] = '중립 건수'
this.subject[sections[5]][7] = '부정 건수'
this.subject[sections[5]][8] = '핵심 키워드 5가지'
this.subject[sections[5]][14] = '비고'


let keys_array = []
let wordCloud = '없음'

let dateRanges = ['1일', '1주일', '1개월', '6개월', '1년'];
let bass

// 기간별 예측값
for(let i = 0; i < this.top_mover_forecast.entries.length; i++) {
    let entry = this.top_mover_forecast.entries[i]
    
    bass = 4 * i + i 
    let row = sections[0] + 1 + bass
    for(let s = 0; s < entry.horizons.length; s++) {
        if (entry.horizons[s].horizon == '1d') {
            this.subject[row][3] = dateRanges[0]
        }else if (entry.horizons[s].horizon == '1w') {
            this.subject[row][3] = dateRanges[1]
        }else if (entry.horizons[s].horizon == '1m') {
            this.subject[row][3] = dateRanges[2]
        }else if (entry.horizons[s].horizon == '6m') {
            this.subject[row][3] = dateRanges[3]
        }else if (entry.horizons[s].horizon == '1y') {
            this.subject[row][3] = dateRanges[4]
        }else {
            this.subject[row][3] = '그 외'
        }
        
        this.subject[row][4] = entry.horizons[s].predicted_price
        this.subject[row][5] = entry.horizons[s].actual_price
        this.subject[row][6] = entry.horizons[s].abs_error
        this.subject[row][7] = entry.horizons[s].predicted_return
        this.subject[row][8] = entry.horizons[s].actual_return
        this.subject[row][9] = entry.horizons[s].return_abs_error
        
        row++
    }
}

// AI 분석
let keys = Object.keys(this.Gemini_Api.stocks)

for (let i = 0; i < keys.length; i++) {
    let bass = 4 * i + i 
    let row = sections[1] + 1 + bass
    let periodKey = Object.keys(this.Gemini_Api.stocks[keys[i]].periods)

    for (let s = 0; s < periodKey.length; s++) {
        this.subject[row][3] = dateRanges[s]
        this.subject[row][4] = this.Gemini_Api.stocks[keys[i]].periods[periodKey[s]].verdict
        this.subject[row][5] = this.Gemini_Api.stocks[keys[i]].periods[periodKey[s]].text

        row++;
    }
}

for (let i = 0; i < this.top_mover_forecast.entries.length; i++) {
    let entry = this.top_mover_forecast.entries[i]
    
    // 기준 시점 주가 및 거래량
    row = sections[2] + 1 + i 
    this.subject[row][3] = entry.current_price
    this.subject[row][4] = entry.change_pct + '%'
    this.subject[row][5] = entry.indicators.obv
    this.subject[row][6] = entry.fundamentals.market_cap

    // 재무제표
    row = sections[3] + 1 + i 
    this.subject[row][3] = entry.fundamentals.fund_revenue
    this.subject[row][4] = entry.fundamentals.fund_operating_income
    this.subject[row][5] = entry.fundamentals.fund_net_income
    this.subject[row][6] = Math.round(entry.fundamentals.per * 100) / 100
    this.subject[row][7] = Math.round(entry.fundamentals.pbr * 100) / 100
    this.subject[row][8] = entry.fundamentals.roe
    this.subject[row][9] = entry.fundamentals.roa
    this.subject[row][10] = Math.round(entry.fundamentals.debt_ratio * 100) / 100 + '%'
    this.subject[row][11] = Math.round(entry.fundamentals.current_ratio * 100) / 100 + '%'
    this.subject[row][12] = Math.round(entry.fundamentals.quick_ratio * 100) / 100 + '%'
    this.subject[row][13] = Math.round(entry.fundamentals.equity_ratio * 100) / 100 + '%'

    // 기술적 지표
    row = sections[4] + 2 + i 
    this.subject[row][3] = Math.round(entry.indicators.rsi)
    
    let rsi_level
    if(this.subject[row][3] >= 71) {
        rsi_level = '과매수'
    }else if((this.subject[row][3] >= 61) && (this.subject[row][3] <= 70)){
        rsi_level = '과매수 경계'
    }else if((this.subject[row][3] >= 41) && (this.subject[row][3] <= 60)){
        rsi_level = '중립'
    }else if((this.subject[row][3] >= 31) && (this.subject[row][3] <= 40)){
        rsi_level = '과매도 경계'
    }else if (this.subject[row][3] <= 30){
        rsi_level = '과매도'
    }else {
        rsi_level = '없음'
    }
    
    this.subject[row][4] = rsi_level
    this.subject[row][5] = entry.indicators.obv
    this.subject[row][6] = entry.indicators.macd
    this.subject[row][7] = entry.indicators.bb_upper
    this.subject[row][8] = entry.indicators.bb_mid
    this.subject[row][9] = entry.indicators.bb_lower
}

// 키워드 상위 5개
for(let i = 0; i < this.sentiment_report.length; i++) {
    wordCloud = this.sentiment_report[i].keywordAnalysis.wordCloud
    if(wordCloud == '없음') {
        break;
    }
    let keys = '';
    let count = 0;

    for (const key in wordCloud) {
        if (count === 5) {
            break;
        }
        
        if (keys !== '') {
            keys += ', ';
        }
        
        keys += key;
        count++;
    }
    
    keys_array[i] = keys
}

for (let i = 0; i < this.sentiment_report.length; i++) {
    let row = sections[5] + 1 + i 
    this.subject[row][3] = this.sentiment_report[i].sentimentAnalysis.overallSentiment 
    this.subject[row][4] = this.sentiment_report[i].sentimentAnalysis.averageScore 
    this.subject[row][5] = this.sentiment_report[i].sentimentAnalysis.sentimentDistribution.positive 
    this.subject[row][6] = this.sentiment_report[i].sentimentAnalysis.sentimentDistribution.neutral 
    this.subject[row][7] = this.sentiment_report[i].sentimentAnalysis.sentimentDistribution.negative
    this.subject[row][8] = keys_array[i]
    
    for(let j = 3; j < 9; j++) {
        if(this.subject[row][j] == undefined) {
            this.subject[row][j] = 0
        }
    }
}


]]></Script>
    </Step>
