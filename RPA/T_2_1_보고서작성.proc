        <Property type="Flow" key="Conditions_Title" controlType="String" valueType="System.String" formatType="String" required="True" visible="True" readonly="False" encrypted="False" isChanged="N" value="날짜및 보고서 상단 설정" />
        <Property type="Flow" key="Key_Script" controlType="PropertyItemTextEditorView" valueType="System.String" formatType="String" required="False" visible="True" readonly="False" encrypted="False" isChanged="N" value="//엑셀 기준 B2 = (0, 0)&#xD;&#xA;&#xD;&#xA;//작성날짜&#xD;&#xA;this.datetime = new Date();&#xD;&#xA;Global.date = this.datetime.toISOString().slice(0, 10);&#xD;&#xA;&#xD;&#xA;let year = Global.date.slice(0, 4);&#xD;&#xA;let month = Global.date.slice(5, 7);&#xD;&#xA;let hour = String(this.datetime.getHours()).padStart(2, '0');&#xD;&#xA;let minute = String(this.datetime.getMinutes()).padStart(2, '0');&#xD;&#xA;&#xD;&#xA;// 보고서 저장 위치&#xD;&#xA;Global.report_path = Global.file_path.replace(/raws$/, &quot;outputs&quot;);&#xD;&#xA;Global.report_path = Global.report_path + '\\보고서\\' + year + '\\' + month&#xD;&#xA;&#xD;&#xA;this.datetime = Global.date + ' ' + hour + ':' + minute;&#xD;&#xA;&#xD;&#xA;//보고서 상단&#xD;&#xA;this.header[0] = []&#xD;&#xA;this.header[0][0] = '핵심 이슈 및 투자 정보 리포트'&#xD;&#xA;this.header[2] = []&#xD;&#xA;this.header[2][0] = '작성자'&#xD;&#xA;this.header[2][3] = 'SIGNAL.KR'&#xD;&#xA;this.header[3] = []&#xD;&#xA;this.header[3][0] = '작성일'&#xD;&#xA;this.header[3][3] = '\'' + this.datetime&#xD;&#xA;this.header[4] = []&#xD;&#xA;this.header[4][0] = '출처'&#xD;&#xA;this.header[4][3] = '키움 API, 네이버 API'&#xD;&#xA;&#xD;&#xA;this.datetime = Global.date + '_' + hour + '_' + minute;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// 분석파일 경로 설정&#xD;&#xA;this.read_path = Global.file_path.replace(/raws$/, &quot;outputs&quot;);&#xD;&#xA;&#xD;&#xA;" />
      </Properties>
      <RelatedSteps />
      <Script><![CDATA[//엑셀 기준 B2 = (0, 0)

//작성날짜
this.datetime = new Date();
Global.date = this.datetime.toISOString().slice(0, 10);

let year = Global.date.slice(0, 4);
let month = Global.date.slice(5, 7);
let hour = String(this.datetime.getHours()).padStart(2, '0');
let minute = String(this.datetime.getMinutes()).padStart(2, '0');

// 보고서 저장 위치
Global.report_path = Global.file_path.replace(/raws$/, "outputs");
Global.report_path = Global.report_path + '\\보고서\\' + year + '\\' + month

this.datetime = Global.date + ' ' + hour + ':' + minute;

//보고서 상단
this.header[0] = []
this.header[0][0] = '핵심 이슈 및 투자 정보 리포트'
this.header[2] = []
this.header[2][0] = '작성자'
this.header[2][3] = 'SIGNAL.KR'
this.header[3] = []
this.header[3][0] = '작성일'
this.header[3][3] = '\'' + this.datetime
this.header[4] = []
this.header[4][0] = '출처'
this.header[4][3] = '키움 API, 네이버 API'

this.datetime = Global.date + '_' + hour + '_' + minute;


// 분석파일 경로 설정
this.read_path = Global.file_path.replace(/raws$/, "outputs");

]]></Script>
    </Step>
