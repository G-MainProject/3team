# SNS API 토큰 설정 예시
# 실제 토큰을 발급받아 아래 값들을 설정하세요

# Twitter API Bearer Token
# https://developer.twitter.com/en/portal/dashboard 에서 발급
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# Threads API Access Token  
# https://developers.facebook.com/tools/explorer/ 에서 발급
THREADS_ACCESS_TOKEN=your_threads_access_token_here
